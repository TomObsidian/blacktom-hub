<section class="hub-section">
  <p class="section-eyebrow">{{ block.eyebrow }}</p>
  <p class="section-title">{{ block.title }}</p>
  {% if block.subtitle %}<p class="lede" style="margin-top:10px;max-width:600px;">{{ block.subtitle }}</p>{% endif %}

  <div class="partners" style="padding-top:32px;">
    {% for p in partnersData.partners %}
    {% if p | isPartnerActive %}
    <div class="pcard">
      <div class="pcard-head">
        {% if p.logo %}<img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy" decoding="async" style="width:48px;height:48px;border-radius:12px;object-fit:cover;">{% else %}<div class="letter-mark">{{ p.name | first }}</div>{% endif %}
        <div><div class="name">{{ p.name }}</div><div class="tag">{{ p.category | default("Partenaire") }}</div></div>
      </div>
      {% if p.offer %}<div class="code-row"><span class="k">Offre</span><span class="v">{{ p.offer }}</span></div>{% endif %}
      {% if p.code %}
      <div class="code-row"><span class="k">Code</span><span class="v">{{ p.code }}</span></div>
      <button type="button" class="btn btn-ghost btn-block" style="margin-bottom:8px;" onclick="copyPromoCode('{{ p.slug }}','{{ p.code }}',this,'home','homepage_partners')">Copier le code</button>
      {% endif %}
      <a href="{{ p | partnerUrl }}" class="btn btn-primary btn-block" target="_blank" rel="noopener nofollow sponsored" onclick="trackPartnerClick('{{ p.slug }}','/','homepage_partners',{content_type:'homepage',cta_type:'partner'})">Découvrir →</a>
    </div>
    {% endif %}
    {% endfor %}
  </div>

  <p style="margin-top:20px;font-size:12px;color:var(--dim2);max-width:600px;">Certains liens sont affiliés. Si tu passes par eux, BLACKTOM peut recevoir une commission, sans surcoût pour toi.</p>

  {% if block.ctaText %}
  <div class="btn-row" style="justify-content:flex-start;padding-top:8px;">
    <a href="{{ block.ctaUrl }}" class="btn btn-ghost" data-track="cta_partenaires_home">{{ block.ctaText }}</a>
  </div>
  {% endif %}
</section>
