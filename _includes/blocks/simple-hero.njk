<section style="padding-top:56px;">
  <p class="eyebrow">{{ block.eyebrow }}</p>
  <h1 style="font-size:clamp({{ block.titleSizeMin | default('38px') }},8vw,{{ block.titleSizeMax | default('64px') }});">{{ block.title }}</h1>
  {% if block.tagline %}<p class="tagline" style="margin-bottom:0;">{{ block.tagline }}</p>{% endif %}
  {% if block.lede %}<p class="lede" style="max-width:{{ block.ledeMaxWidth | default('600px') }};">{{ block.lede }}</p>{% endif %}
  {% if block.subtext %}<p style="margin-top:12px;font-size:14px;color:var(--dim);max-width:560px;">{{ block.subtext }}</p>{% endif %}
</section>
{% if block.ctaText %}
<div class="btn-row" style="justify-content:flex-start;">
  <a href="{{ block.ctaUrl }}" class="btn btn-primary">{{ block.ctaText }}</a>
</div>
{% endif %}
