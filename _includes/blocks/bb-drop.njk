<section class="hub-section" id="drop-form">
  <div class="bb-alert">
    <div>
      {% if block.eyebrow %}<p class="sec-label">{{ block.eyebrow }}</p>{% endif %}
      {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
      {% if block.text %}<p>{{ block.text }}</p>{% endif %}
      {% if block.image %}
      <figure style="margin:28px 0 0;max-width:420px;aspect-ratio:3/2;overflow:hidden;">
        <img src="{{ block.image }}" alt="{{ block.imageAlt | default('') }}" width="800" height="1200" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:{{ block.imagePosition | default('50% 30%') }};display:block;">
      </figure>
      {% endif %}
    </div>

    {% if dropSettings.waitlistEnabled %}
    <div class="signup-card">
      {% if block.formTitle %}<p style="margin:0 0 14px;font-family:var(--ph);font-weight:800;font-size:18px;color:var(--wht);">{{ block.formTitle }}</p>{% endif %}
      <form name="black-boar-drop" method="POST" data-netlify="true" netlify-honeypot="bb-hp" action="merci-blackboar.html" data-newsletter data-track-event="blackboar_waitlist_signup" data-source-page="blackboar" data-source-component="drop_section">
        <input type="hidden" name="form-name" value="black-boar-drop">
        <input type="hidden" name="source" value="black_boar_drop">
        <input type="hidden" name="source_page" value="blackboar">
        <input type="hidden" name="source_component" value="drop_section">
        <p class="signup-hp" aria-hidden="true"><input type="text" name="bb-hp" tabindex="-1" autocomplete="off" value=""></p>
        <div class="signup-row">
          <label for="newsletter-email" class="sr-only">Adresse email</label>
          <input type="email" id="newsletter-email" name="email" placeholder="ton@email.com" required autocomplete="email">
          <label class="signup-consent">
            <input type="checkbox" name="consent" required>
            <span>{{ block.consentText }} <a href="confidentialite.html">Politique de confidentialité</a></span>
          </label>
          <button type="submit" class="btn btn-primary btn-block">{{ block.ctaText }}</button>
        </div>
      </form>
    </div>
    {% endif %}
  </div>
</section>
