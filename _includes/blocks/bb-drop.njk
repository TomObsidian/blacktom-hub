<section class="hub-section" id="drop-form">
  <p class="section-eyebrow">{{ block.eyebrow }}</p>
  <p class="section-title">{{ block.title }}</p>
  <p style="margin-top:14px;font-size:14px;color:var(--dim);max-width:560px;">{{ block.text }}</p>

  {% if block.image %}
  <div style="margin-top:28px;border-radius:20px;overflow:hidden;max-width:680px;aspect-ratio:16/9;">
    <img src="{{ block.image }}" alt="{{ block.imageAlt | default('') }}" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block;">
  </div>
  {% endif %}

  {% if dropSettings.waitlistEnabled %}
  <div class="signup-card" style="margin-top:28px;">
    <p style="margin:0 0 14px;font-family:var(--ph);font-weight:800;font-size:18px;color:var(--wht);">{{ block.formTitle }}</p>
    <form name="black-boar-drop" method="POST" data-netlify="true" netlify-honeypot="bb-hp" action="merci-blackboar.html" data-newsletter data-track-event="blackboar_waitlist_signup" data-source-page="blackboar" data-source-component="drop_section">
      <input type="hidden" name="form-name" value="black-boar-drop">
      <input type="hidden" name="source" value="black_boar_drop">
      <input type="hidden" name="source_page" value="blackboar">
      <input type="hidden" name="source_component" value="drop_section">
      <p class="signup-hp" aria-hidden="true"><label>Ne pas remplir : <input name="bb-hp" tabindex="-1" autocomplete="off"></label></p>
      <div class="signup-row">
        <input type="email" name="email" placeholder="ton@email.com" required autocomplete="email">
        <label class="signup-consent">
          <input type="checkbox" name="consent" required>
          <span>{{ block.consentText }} <a href="confidentialite.html">Politique de confidentialité</a></span>
        </label>
        <button type="submit" class="btn btn-primary btn-block">{{ block.ctaText }}</button>
      </div>
    </form>
  </div>
  {% endif %}
</section>
