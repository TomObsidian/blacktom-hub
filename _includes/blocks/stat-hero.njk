{% set value = status[block.statKey] %}
{% if value %}
{% set ratio = value | statRatio(status.poids) %}
<div class="ledger">
  <div class="ledger-inner">
    <div>
      <p class="ledger-label">{{ block.label }}</p>
      <p class="ledger-figure"><span class="n">{{ value | statNumber }}</span><span class="u">{{ value | statUnit }}</span></p>
    </div>
    <div>
      <dl class="ledger-rows">
        {% if status.poids %}<div><dt>Poids de corps</dt><dd>{{ status.poids | statNumber }} {{ status.poids | statUnit }}</dd></div>{% endif %}
        {% if ratio %}<div><dt>Rapport au poids de corps</dt><dd>{{ ratio }} ×</dd></div>{% endif %}
        {% if block.goalKey and status[block.goalKey] %}<div><dt>Objectif</dt><dd>{{ status[block.goalKey] }}</dd></div>{% endif %}
      </dl>
      {% if block.note %}<p class="ledger-note">{{ block.note }}</p>{% endif %}
      {% if block.ctaText %}<p style="margin:22px 0 0;"><a href="{{ block.ctaUrl }}" class="link-arrow">{{ block.ctaText }}</a></p>{% endif %}
    </div>
  </div>
</div>
{% endif %}
