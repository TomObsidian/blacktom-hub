<style>
/* Style local au hero Black Boar : fond sombre + halo rouge + mark, comme sur
   black-boar-athletics.html. Classes prefixees bb- pour ne rien partager
   avec le bloc hero.njk generique (.hero/.hero-bg/.hero-scrim/.hero-inner
   restent inchangees et utilisees par d'autres pages). */
.bb-hero{background:#0a0a0a;}
.bb-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5;}
.bb-hero-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.55) 0%,rgba(10,10,10,.78) 58%,var(--bg) 100%);}
.bb-hero-glow{position:absolute;inset:0;background:radial-gradient(68% 50% at 50% 30%,rgba(139,13,13,.42),transparent 76%);pointer-events:none;}
.bb-hero-mark{width:min(40vw,180px);height:auto;filter:drop-shadow(0 22px 48px rgba(0,0,0,.7));margin-bottom:20px;}
@media(min-width:820px){ .bb-hero-mark{width:min(18vw,220px);} }
</style>
<div class="hero bb-hero">
  {% if block.image %}<img class="bb-hero-bg" src="{{ block.image }}" alt="" style="object-position:{{ block.imagePosition | default('50% 50%') }};">{% endif %}
  <div class="bb-hero-scrim"></div>
  <div class="bb-hero-glow"></div>
  <div class="hero-inner">
    <img class="bb-hero-mark" src="/assets/logo-black-boar-mark.png" alt="Black Boar">
    <h1 style="font-size:clamp(34px,8vw,72px);">{{ block.title }}</h1>
    {% if block.tagline %}<p class="tagline">{{ block.tagline }}</p>{% endif %}
    <p class="eyebrow">{{ block.eyebrow }}</p>
    {% if block.lede %}<p class="lede">{{ block.lede }}</p>{% endif %}
  </div>
</div>
<div class="btn-row">
  <a href="{{ block.ctaUrl }}" class="btn btn-primary" data-track="cta_blackboar_hero">{{ block.ctaText }}</a>
</div>
