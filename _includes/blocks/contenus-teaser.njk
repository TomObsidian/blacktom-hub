{# Journal : un dossier pleine largeur, puis des entrées d'index numérotées. #}
<section class="journal" id="contenus">
  <div class="sec-head">
    <div>
      {% if block.eyebrow %}<p class="sec-label">{{ block.eyebrow }}</p>{% endif %}
      <h2 class="sec-title">{{ block.title }}</h2>
    </div>
    {% if block.ctaText %}<a href="{{ block.ctaUrl }}" class="link-line" data-track="cta_contenus">{{ block.ctaText }}</a>{% endif %}
  </div>
  {% for item in block.items %}
  {% if loop.first %}
  <a class="dossier" href="{{ item.url }}">
    <figure class="rv"><img src="{{ item.image }}"{% if item.imageSmall %} srcset="{{ item.imageSmall }} 1000w, {{ item.image }} 2200w" sizes="calc(100vw - 2 * var(--pad))"{% endif %} alt="{{ item.imageAlt | default('') }}" width="2200" height="944" loading="lazy" decoding="async" style="--pos:{{ item.imagePosition | default('50% 40%') }};"></figure>
    <div class="dossier-body">
      <p class="dossier-n">01</p>
      <div>
        <h3>{{ item.title }}</h3>
        {% if item.description %}<p class="chapo">{{ item.description }}</p>{% endif %}
        <span class="link-line">{{ item.linkText | default('Lire le dossier') }}</span>
      </div>
    </div>
  </a>
  <ol class="entries">
  {% else %}
    <li>
      <a class="entry" href="{{ item.url }}">
        <div class="entry-head"><span class="entry-n">{{ '0' if loop.index < 10 }}{{ loop.index }}</span><span class="entry-cat">{{ item.category }}</span></div>
        <div class="entry-text">
          <h3>{{ item.title }}</h3>
          {% if item.description %}<p>{{ item.description }}</p>{% endif %}
        </div>
        <figure class="rv"><img src="{{ item.image }}"{% if item.imageSmall %} srcset="{{ item.imageSmall }} 480w, {{ item.image }} 900w" sizes="(min-width:900px) 280px, 26vw"{% endif %} alt="{{ item.imageAlt | default('') }}" width="900" height="900" loading="lazy" decoding="async" style="object-position:{{ item.imagePosition | default('50% 35%') }};"></figure>
      </a>
    </li>
  {% endif %}
  {% if loop.last %}</ol>{% endif %}
  {% endfor %}
</section>
