{# Univers : trois lignes d'index, pas de cartes. #}
<section class="univers fonte" id="projets">
  <div class="sec-head">
    <div>
      {% if block.eyebrow %}<p class="sec-label">{{ block.eyebrow }}</p>{% endif %}
      <h2 class="sec-title">{{ block.title }}</h2>
    </div>
  </div>
  {% for item in block.items %}
  <article class="row">
    {% if item.kicker %}<span class="kicker">{{ item.kicker }}</span>{% endif %}
    <div class="row-main">
      {% if item.showMark %}<img class="row-mark" src="/assets/logo-black-boar-mark.svg" alt="" width="64" height="53" loading="lazy" decoding="async">{% endif %}
      <h3>{{ item.title }}</h3>
      <p>{{ item.text }}</p>
      {% if item.socialPlatform %}
      <a href="{{ item.ctaUrl }}" class="link-line" target="_blank" rel="noopener me" onclick="trackEvent('social_click',{platform:'{{ item.socialPlatform }}',source_page:'/',placement:'{{ item.trackId | default('project') }}'})">{{ item.ctaText }}</a>
      {% else %}
      <a href="{{ item.ctaUrl }}" class="link-line" data-track="{{ item.trackId | default('cta_project') }}">{{ item.ctaText }}</a>
      {% endif %}
    </div>
    {% if item.image %}
    <figure class="rv"><img src="{{ item.image }}"{% if item.imageSmall %} srcset="{{ item.imageSmall }} 560w, {{ item.image }} 1000w" sizes="(min-width:900px) 280px, 22vw"{% endif %} alt="{{ item.imageAlt | default('') }}" width="1000" height="1000" loading="lazy" decoding="async" style="object-position:{{ item.imagePosition | default('50% 35%') }};"></figure>
    {% endif %}
  </article>
  {% endfor %}
</section>
