{# La liste : une phrase, un champ souligné, une case carrée, le bouton rouge. #}
<section class="liste sang" id="liste">
  <div class="liste-inner">
    <div>
      {% if block.eyebrow %}<p class="liste-title">{{ block.eyebrow }}</p>{% endif %}
      <h2>{{ block.title | default('Suivre BLACKTOM') }}</h2>
      {% if block.description %}<p class="d">{{ block.description }}</p>{% endif %}
    </div>
    <div class="signup-card">
      <form name="blacktom-liste" method="POST" data-netlify="true" netlify-honeypot="bb-hp" action="merci-blacktom.html" data-newsletter data-source-page="home" data-source-component="inline">
        <input type="hidden" name="form-name" value="blacktom-liste">
        <input type="hidden" name="source_page" value="home">
        <input type="hidden" name="source_component" value="inline">
        <p class="signup-hp" aria-hidden="true"><input type="text" name="bb-hp" tabindex="-1" autocomplete="off" value=""></p>
        <div class="signup-row">
          <label for="newsletter-email" class="sr-only">Adresse email</label>
          <input type="email" id="newsletter-email" name="email" placeholder="ton@email.com" required autocomplete="email">
          <label class="signup-consent">
            <input type="checkbox" name="consent" required>
            <span>J'accepte de recevoir les emails de BLACKTOM. Désinscription possible à tout moment. <a href="/confidentialite">Politique de confidentialité</a></span>
          </label>
          <button type="submit" class="btn btn-primary btn-block">Rejoindre la liste</button>
        </div>
      </form>
    </div>
  </div>
</section>
