<section class="presse gallery">
  <div class="placeholders">
    {% for photo in block.photos %}
    <figure class="photo-tile"><img src="{{ photo.image }}" alt="{{ photo.alt | default('') }}" width="900" height="900" loading="lazy" decoding="async">{% if photo.caption %}<figcaption>{{ photo.caption }}</figcaption>{% endif %}</figure>
    {% endfor %}
  </div>
</section>
