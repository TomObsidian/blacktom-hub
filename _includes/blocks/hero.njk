<div class="hero">
  <img class="hero-bg" src="{{ block.image }}" alt="" style="object-position:{{ block.imagePosition | default('50% 50%') }};">
  <div class="hero-scrim"></div>
  <div class="hero-inner">
    <h1>{{ block.title }}</h1>
    <p class="tagline">{{ block.tagline }}</p>
    <p class="lede">{{ block.lede }}</p>
  </div>
</div>
<div class="btn-row">
  <a href="{{ block.primaryCtaUrl }}" class="btn btn-primary" data-track="cta_hero_apropos">{{ block.primaryCtaText }}</a>
</div>
{% if block.secondaryCtaText %}
<div class="hero-secondary">
  <a href="{{ block.secondaryCtaUrl }}" class="btn-subtle" data-track="cta_hero_partenaires">{{ block.secondaryCtaText }}</a>
</div>
{% endif %}
