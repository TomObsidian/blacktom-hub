<div class="hero">
  <img class="hero-bg" src="{{ block.image }}" alt="" style="object-position:{{ block.imagePosition | default('50% 50%') }};">
  <div class="hero-scrim"></div>
  <div class="hero-inner">
    <h1>{{ block.title }}</h1>
    <p class="tagline">{% for line in block.tagline | splitLines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {% if block.lede %}<p class="lede">{{ block.lede }}</p>{% endif %}
  </div>
</div>
{% if block.primaryCtaText %}
<div class="btn-row">
  <a href="{{ block.primaryCtaUrl }}" class="btn btn-primary" data-track="cta_hero_primary">{{ block.primaryCtaText }}</a>
  {% if block.secondaryCtaText %}<a href="{{ block.secondaryCtaUrl }}" class="btn btn-ghost" data-track="cta_hero_secondary">{{ block.secondaryCtaText }}</a>{% endif %}
</div>
{% endif %}
