permalink: "contenus.html"
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ contenusPage.seoTitle }}</title>
<meta name="description" content="{{ contenusPage.seoDescription }}">
<link rel="canonical" href="https://blacktom.fr/contenus">
<meta property="og:type" content="website">
<meta property="og:url" content="https://blacktom.fr/contenus">
<meta property="og:title" content="{{ contenusPage.seoTitle }}">
<meta property="og:description" content="{{ contenusPage.seoDescription }}">
<meta property="og:image" content="https://blacktom.fr/assets/icone-512-8692beb4.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="assets/icone-192-2f225757.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://blacktom.fr/"},
    {"@type": "ListItem", "position": 2, "name": "Contenus", "item": "https://blacktom.fr/contenus"}
  ]
}
</script>
</head>
<body>

<nav class="nav">
  <a href="index.html" class="brand">
    <img src="assets/avatar-black-tom-de3dd432.jpg" alt="">
    BLACKTOM
  </a>
  <div class="nav-links">
    <a href="contenus.html" aria-current="page">Journal</a>
    <a href="outils/">Bench Lab</a>
    <a href="black-boar.html">Black Boar</a>
    <a href="ultimate-method.html">Ultimate Method</a>
    <a href="a-propos.html">À propos</a>
  </div>
  <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="contenus.html" aria-current="page">Journal</a>
  <a href="outils/">Bench Lab</a>
  <a href="black-boar.html">Black Boar</a>
  <a href="ultimate-method.html">Ultimate Method</a>
  <a href="a-propos.html">À propos</a>
</div>

{% for block in contenusPage.blocks %}
{% if block.visible != false %}
{% if block.type == "simple-hero" %}{% include "blocks/simple-hero.njk" %}{% endif %}
{% endif %}
{% endfor %}

<div class="partners" id="category-grid" style="padding-top:44px;">
  {% for cat in contentData.categories %}
  <a class="pcard" href="{{ cat.slug }}">
    <div class="pcard-head"><div class="letter-mark">{{ cat.name | first }}</div><div><div class="name">{{ cat.name }}</div><div class="tag">Catégorie</div></div></div>
    <p class="desc">{{ cat.tagline }}</p>
  </a>
  {% endfor %}
</div>

<footer>
  <div class="foot-grid">
    <div>
      <div class="foot-brand">BLACKTOM</div>
      <p class="foot-tag">Force &amp; physique après 40 ans.</p>
      <div class="signup-compact">
        <div class="signup-compact-title">BLACKTOM — La liste</div>
        <form name="blacktom-liste" method="POST" data-netlify="true" netlify-honeypot="bb-hp" action="merci-blacktom.html" data-newsletter data-source-page="contenus" data-source-component="footer">
          <input type="hidden" name="form-name" value="blacktom-liste">
          <input type="hidden" name="source_page" value="contenus">
          <input type="hidden" name="source_component" value="footer">
          <p class="signup-hp" aria-hidden="true"><input type="text" name="bb-hp" tabindex="-1" autocomplete="off" value=""></p>
          <div class="signup-compact-row">
            <input type="email" name="email" placeholder="ton@email.com" required autocomplete="email">
            <button type="submit">OK</button>
          </div>
          <label class="signup-compact-legal" style="display:flex;gap:6px;align-items:flex-start;cursor:pointer;">
            <input type="checkbox" name="consent" required style="margin-top:2px;flex-shrink:0;">
            <span>J'accepte de recevoir les emails de BLACKTOM. <a href="confidentialite.html">Politique de confidentialité</a></span>
          </label>
        </form>
      </div>
    </div>
    <div>
      <div class="foot-h">Navigation</div>
      <a href="contenus.html">Journal</a>
      <a href="outils/">Bench Lab</a>
      <a href="black-boar.html">Black Boar</a>
      <a href="ultimate-method.html">Ultimate Method</a>
      <a href="a-propos.html">À propos</a>
      <a href="partenaires.html">Partenaires</a>
    </div>
    <div>
      <div class="foot-h">Réseaux</div>
      <a class="item" href="https://www.instagram.com/xblacktomx/" target="_blank" rel="noopener me">Instagram</a>
      <a class="item" href="https://www.tiktok.com/@tomobsidian" target="_blank" rel="noopener me">TikTok</a>
    </div>
    <div>
      <div class="foot-h">Contact &amp; légal</div>
      <a class="item" href="mailto:thomas.obsidian@gmail.com">thomas.obsidian@gmail.com</a>
      <div class="item" style="font-size:12px;">
        <a href="mentions-legales.html" style="color:var(--dim2);">Mentions légales</a>
        · <a href="confidentialite.html" style="color:var(--dim2);">Confidentialité</a>
      </div>
    </div>
  </div>
  <p class="foot-legal">© BLACKTOM. Certains liens vers des partenaires sont des liens affiliés.</p>
</footer>

<script src="content.js"></script>
<script src="app.js"></script>
<script src="newsletter.js"></script>
</body>
</html>
