<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ contenusPage.seoTitle }}</title>
<meta name="description" content="{{ contenusPage.seoDescription }}">
<link rel="canonical" href="https://blacktom.fr/contenus">
<meta property="og:type" content="website">
<meta property="og:url" content="https://blacktom.fr/contenus">
<meta property="og:title" content="{{ contenusPage.seoTitle }}">
<meta property="og:description" content="{{ contenusPage.seoDescription }}">
<meta property="og:image" content="https://blacktom.fr/assets/icone-512-8692beb4.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="assets/icone-192-2f225757.png">
<link rel="preload" href="/assets/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/big-shoulders-display-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/newsreader-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#080807">
<link rel="stylesheet" href="styles.css">
<script src="analytics.js" defer></script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://blacktom.fr/"},
    {"@type": "ListItem", "position": 2, "name": "Contenus", "item": "https://blacktom.fr/contenus"}
  ]
}
</script>
</head>
<body class="p-hub">
<a class="skip" href="#main">Aller au contenu</a>

<nav class="nav">
  <a href="/" class="brand">
    BLACKTOM
  </a>
  <div class="nav-links">
    <a href="/contenus" aria-current="page">Journal</a>
    <a href="/outils/">Outils</a>
    <a href="/partenaires">Codes promo</a>
    <a href="/black-boar">Black Boar</a>
    <a href="/ultimate-method">Ultimate Method</a>
    <a href="/a-propos">À propos</a>
  </div>
  <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/contenus" aria-current="page">Journal</a>
  <a href="/outils/">Outils</a>
  <a href="/partenaires">Codes promo</a>
  <a href="/black-boar">Black Boar</a>
  <a href="/ultimate-method">Ultimate Method</a>
  <a href="/a-propos">À propos</a>
</div>

<main id="main">

{% for block in contenusPage.blocks %}
{% if block.visible != false %}
{% if block.type == "simple-hero" %}{% include "blocks/simple-hero.njk" %}{% endif %}
{% endif %}
{% endfor %}

{% for c in contentData.content %}
{% if c.type == "pilier" and c.status == "published" %}
<section class="hub-section">
  <a class="journal-lead" href="{{ c.url }}" data-track="cta_pilier_musculation40">
    <figure><img src="{{ c.image }}"{% if c.imageSmall %} srcset="{{ c.imageSmall }} 480w, {{ c.image }} 900w" sizes="(min-width:900px) 56vw, 100vw"{% endif %} alt="{{ c.imageAlt | default('') }}" width="900" height="900" loading="lazy" decoding="async" style="--pos:{{ c.imagePosition | default('50% 35%') }};"></figure>
    <div>
      <span class="kicker">Pilier</span>
      <h2>{{ c.title | softAge | safe }}</h2>
      <p>Force, entraînement, récupération et nutrition : mon approche complète.</p>
      <span class="link-arrow">Lire le dossier</span>
    </div>
  </a>
</section>
{% endif %}
{% endfor %}

<section class="hub-section" id="rubriques">
  <div class="sec-head">
    <div>
      <p class="sec-label">Rubriques</p>
      <h2 class="sec-title">Par thème</h2>
    </div>
  </div>
  <ul class="cat-list">
    {% for cat in contentData.categories %}
    <li><a class="cat-row" href="{{ cat.slug }}">
      <h3>{{ cat.name }}</h3>
      <p>{{ cat.tagline }}</p>
    </a></li>
    {% endfor %}
  </ul>
</section>

</main>

<footer>
  <div class="foot-grid">
    <div>
      <div class="foot-brand">BLACKTOM</div>
      <p class="foot-tag">Force. Physique. Full Black.</p>
      <div class="signup-compact">
        <div class="signup-compact-title">La liste BLACKTOM</div>
        <form name="blacktom-liste" method="POST" data-netlify="true" netlify-honeypot="bb-hp" action="merci-blacktom.html" data-newsletter data-source-page="contenus" data-source-component="footer">
          <input type="hidden" name="form-name" value="blacktom-liste">
          <input type="hidden" name="source_page" value="contenus">
          <input type="hidden" name="source_component" value="footer">
          <p class="signup-hp" aria-hidden="true"><input type="text" name="bb-hp" tabindex="-1" autocomplete="off" value=""></p>
          <div class="signup-compact-row">
            <label for="newsletter-email-footer" class="sr-only">Adresse email</label>
            <input type="email" id="newsletter-email-footer" name="email" placeholder="ton@email.com" required autocomplete="email">
            <button type="submit">OK</button>
          </div>
          <label class="signup-compact-legal" style="display:flex;gap:6px;align-items:flex-start;cursor:pointer;">
            <input type="checkbox" name="consent" required style="margin-top:2px;flex-shrink:0;">
            <span>J'accepte de recevoir les emails de BLACKTOM. <a href="/confidentialite">Politique de confidentialité</a></span>
          </label>
        </form>
      </div>
    </div>
    <div>
      <div class="foot-h">Navigation</div>
      <a href="/contenus">Journal</a>
      <a href="/outils/">Outils</a>
      <a href="/black-boar">Black Boar</a>
      <a href="/ultimate-method">Ultimate Method</a>
      <a href="/a-propos">À propos</a>
      <a href="/partenaires">Codes promo</a>
    </div>
    <div>
      <div class="foot-h">Réseaux</div>
      <a class="item" href="https://www.instagram.com/xblacktomx/" target="_blank" rel="noopener me">Instagram</a>
      <a class="item" href="https://www.tiktok.com/@tomobsidian" target="_blank" rel="noopener me">TikTok</a>
    </div>
    <div>
      <div class="foot-h">Contact &amp; légal</div>
      <a class="item" href="mailto:thomas.obsidian@gmail.com">thomas.obsidian@gmail.com</a>
      <div class="item" style="font-size:12px;">
        <a href="/mentions-legales" style="color:var(--dim2);">Mentions légales</a>
        · <a href="/confidentialite" style="color:var(--dim2);">Confidentialité</a>
      </div>
    </div>
  </div>
  <p class="foot-legal">© BLACKTOM. Certains liens vers des partenaires sont des liens affiliés.</p>
</footer>

<script src="content.js"></script>
<script src="app.js"></script>
<script src="newsletter.js"></script>
</body>
</html>
